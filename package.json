{
  "name": "loopcrop",
  "version": "0.4.0",
  "description": "Drive any AI chat web UI in a loop from the tab you are already signed into: send a prompt, wait for the turn to finish, harvest the files it produced, repeat. Crash-safe: a restarted run replays completed asks from a local journal instead of re-sending them.",
  "type": "module",
  "license": "MIT",
  "author": "C0llap5ar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C0llap5ar/loopcrop.git"
  },
  "bugs": {
    "url": "https://github.com/C0llap5ar/loopcrop/issues"
  },
  "homepage": "https://github.com/C0llap5ar/loopcrop#readme",
  "keywords": [
    "chatgpt",
    "chatgpt-automation",
    "claude",
    "userscript",
    "tampermonkey",
    "browser-automation",
    "automation",
    "prompt-loop",
    "prompt-chaining",
    "loop-crop",
    "agent",
    "no-api-key",
    "crash-recovery",
    "idempotent",
    "resume",
    "batch-generation",
    "novel-writing",
    "content-generation",
    "dataset"
  ],
  "bin": {
    "loopcrop": "cli/loop.mjs"
  },
  "files": [
    "core",
    "cli",
    "gui",
    "dist",
    "docs",
    "examples",
    "scripts",
    "userscript",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-userscript.mjs",
    "version": "node scripts/build-userscript.mjs && git add dist/loopcrop.user.js",
    "start": "node cli/loop.mjs",
    "gui": "node gui/server.mjs",
    "test": "node --test",
    "test:live": "node live/smoke-prompt-integrity.mjs",
    "smoke": "node cli/loop.mjs --recipe ./examples/smoke-recipe.mjs --out ./test-out --turns 1"
  },
  "engines": {
    "node": ">=22"
  }
}
